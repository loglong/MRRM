// Prisma Schema for MRRM - Multi-tenant Medical Patient Relationship Management
// PostgreSQL with Row-Level Security via Prisma Middleware

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Base Entity Pattern - All tenant-aware entities include these fields
// ============================================================================

// BaseEntity is applied via composition in application code, not Prisma
// All user-facing models MUST have orgId field for RLS enforcement

// ============================================================================
// Organization (Tenant)
// ============================================================================

model Organization {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique // Unique organization code for API contexts
  status    OrgStatus @default(ACTIVE)
  domain    String? // Optional domain for SSO mapping
  metadata  Json? // Flexible metadata storage
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  users             User[]
  roles             Role[]
  patients          Patient[]
  demands           Demand[]
  paths             Path[]
  touchpoints       Touchpoint[]
  followupPlans     FollowupPlan[]
  followupRecords   FollowupRecord[]
  auditLogs         AuditLog[]
  journeyMilestones JourneyMilestone[]
  healthRecords     HealthRecord[]
  healthReminders   HealthReminder[]

  @@index([code])
  @@index([status])
  @@map("organizations")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ============================================================================
// User Management
// ============================================================================

model User {
  id                  String     @id @default(uuid())
  email               String
  passwordHash        String?    @map("password_hash")
  name                String
  phone               String?    @db.VarChar(20)
  avatar              String?
  orgId               String     @map("org_id")
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  metadata            Json?
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // Relations
  organization        Organization   @relation(fields: [orgId], references: [id])
  roles               UserRole[]
  auditLogs           AuditLog[]
  patientAssignments  Patient[]      @relation("AssignedUser")
  notifications       Notification[]
  followupAssignments FollowupPlan[] @relation("FollowupAssignedUser")

  @@unique([orgId, email])
  @@index([orgId])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

// ============================================================================
// Role-Based Access Control
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // System code for programmatic access
  description String?
  orgId       String   @map("org_id")
  isSystem    Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization     @relation(fields: [orgId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("roles")
}

model Permission {
  id        String         @id @default(uuid())
  code      String         @unique // e.g., "patient:read", "demand:create"
  name      String
  type      PermissionType
  menuPath  String?        @map("menu_path") // For menu-type permissions
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

enum PermissionType {
  MENU
  BUTTON
  API
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// Audit Logging
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  orgId          String   @map("org_id")
  action         String // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN"
  entityType     String   @map("entity_type") // e.g., "Patient", "Demand"
  entityId       String?  @map("entity_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestMethod  String?  @map("request_method")
  requestPath    String?  @map("request_path")
  requestBody    Json?    @map("request_body")
  responseStatus Int?     @map("response_status")
  errorMessage   String?  @map("error_message")
  // AI 调用扩展字段
  apiKeyId       String?  @map("api_key_id") // API Key 标识
  isAiCall       Boolean  @default(false) @map("is_ai_call") // 是否为 AI 调用
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user         User?        @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([apiKeyId])
  @@map("audit_logs")
}

// ============================================================================
// Patient Core Entity
// ============================================================================

model Patient {
  id              String        @id @default(uuid())
  name            String
  phone           String?       @db.VarChar(20)
  email           String?
  gender          Gender?
  birthDate       DateTime?     @map("birth_date") @db.Date
  idCard          String?       @map("id_card") // Encrypted field
  medicalRecordNo String?       @map("medical_record_no") // Encrypted field @db.VarChar(50)
  // Medical information - AES-256 encrypted
  allergyHistory  String?       @map("allergy_history")
  pastHistory     String?       @map("past_history")
  // Patient classification
  tier            PatientTier   @default(REGULAR)
  orgId           String        @map("org_id")
  status          PatientStatus @default(ACTIVE)
  assignedUserId  String?       @map("assigned_user_id")
  lastVisitAt     DateTime?     @map("last_visit_at")
  nextVisitAt     DateTime?     @map("next_visit_at")
  tags            String[]      @default([]) // Array of tag strings
  metadata        Json?
  encryptedFields Json?         @map("encrypted_fields") // AES-256 encrypted sensitive data
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  organization      Organization       @relation(fields: [orgId], references: [id])
  assignedUser      User?              @relation("AssignedUser", fields: [assignedUserId], references: [id])
  demands           Demand[]
  touchpoints       Touchpoint[]
  followupPlans     FollowupPlan[]
  followupRecords   FollowupRecord[]
  journeyMilestones JourneyMilestone[]
  healthRecords     HealthRecord[]
  healthReminders   HealthReminder[]
  pathInstances     PathInstance[]

  @@index([orgId])
  @@index([status])
  @@index([assignedUserId])
  @@index([phone])
  @@index([orgId, name])
  @@index([tier])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  CHURNED
  DECEASED
}

enum PatientTier {
  HIGH_VALUE
  REGULAR
  LOST_RISK
}

// ============================================================================
// Demand (Patient Need/Opportunity)
// ============================================================================

model Demand {
  id              String       @id @default(uuid())
  patientId       String       @map("patient_id")
  orgId           String       @map("org_id")
  type            DemandType
  source          DemandSource
  title           String
  description     String?
  status          DemandStatus @default(OPEN)
  priority        Priority     @default(MEDIUM)
  estimatedAmount Decimal?     @map("estimated_amount") @db.Decimal(12, 2)
  actualAmount    Decimal?     @map("actual_amount") @db.Decimal(12, 2)
  closeReason     String?      @map("close_reason")
  closedAt        DateTime?    @map("closed_at")
  metadata        Json?

  // 用户字段
  createdBy          String? @map("created_by") // 创建人
  developmentManager String? @map("development_manager") // 开发期管理人(前台)

  // 治疗前期
  preTreatmentStartDate DateTime? @map("pre_treatment_start_date") // 治疗前期开始时间
  preTreatmentManager   String?   @map("pre_treatment_manager") // 治疗前期管理人(护士)

  // 治疗期
  treatmentStartDate DateTime? @map("treatment_start_date") // 治疗期开始时间
  treatmentManager   String?   @map("treatment_manager") // 治疗期管理人(护士)
  treatmentEndDate   DateTime? @map("treatment_end_date") // 治疗结束时间

  // 技术路径
  pathId             String? @map("path_id") // 技术路径ID
  maintenanceManager String? @map("maintenance_manager") // 维护人(护士)
  maintenancePlanId  String? @map("maintenance_plan_id") // 维护方案ID

  // 需求结束时间
  demandEndDate DateTime? @map("demand_end_date") // 需求结束时间

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  patient       Patient               @relation(fields: [patientId], references: [id])
  organization  Organization          @relation(fields: [orgId], references: [id])
  statusHistory DemandStatusHistory[]
  path          Path?                 @relation(fields: [pathId], references: [id])

  @@index([orgId])
  @@index([patientId])
  @@index([status])
  @@index([pathId])
  @@map("demands")
}

model DemandStatusHistory {
  id         String        @id @default(uuid())
  demandId   String        @map("demand_id")
  fromStatus DemandStatus? @map("from_status")
  toStatus   DemandStatus  @map("to_status")
  changedBy  String        @map("changed_by")
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relations
  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId])
  @@map("demand_status_history")
}

enum DemandType {
  CONSULTATION
  TREATMENT
  PURCHASE
  FOLLOWUP
  OTHER
}

enum DemandSource {
  PHONE
  WECHAT
  WEB
  WALK_IN
  REFERRAL
  CAMPAIGN
  OTHER
}

enum DemandStatus {
  OPEN
  IN_PROGRESS
  PENDING
  FULFILLED
  CANCELLED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================================================
// Treatment Path
// ============================================================================

model Path {
  id            String     @id @default(uuid())
  name          String
  description   String?
  orgId         String     @map("org_id")
  version       String     @default("1.0")
  status        PathStatus @default(DRAFT)
  specialty     Specialty? @map("specialty") // 消费医疗专科分类
  icd10Code     String?    @map("icd10_code") // ICD-10 诊断代码
  icd9Code      String?    @map("icd9_code") // ICD-9 诊断代码
  diagnosisName String?    @map("diagnosis_name") // 诊断名称
  surgeryName   String?    @map("surgery_name") // 手术治疗名称
  steps         PathStep[]
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  organization  Organization   @relation(fields: [orgId], references: [id])
  instances     PathInstance[]
  demands       Demand[]
  followupPlans FollowupPlan[]

  @@index([orgId])
  @@map("paths")
}

enum Specialty {
  ORAL // 口腔
  OPHTHALMIC // 眼科
  ORTHOPEDIC // 骨科
  DERMATOLOGY // 皮肤科
  TCM // 中医科
}

enum PathStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model PathStep {
  id                   String   @id @default(uuid())
  pathId               String   @map("path_id")
  name                 String
  description          String?
  stepOrder            Int      @map("step_order")
  stepType             StepType
  estimatedDays        Int?     @map("estimated_days")
  timeoutHours         Int?     @map("timeout_hours")
  triggerAction        String?  @map("trigger_action") // What triggers this step
  notificationTemplate String?  @map("notification_template")
  metadata             Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  path          Path               @relation(fields: [pathId], references: [id], onDelete: Cascade)
  instanceSteps PathInstanceStep[]

  @@index([pathId])
  @@map("path_steps")
}

enum StepType {
  START
  TASK
  AUTOMATED_ACTION
  WAIT
  DECISION
  END
}

// ============================================================================
// Path Instance (Path assigned to patient demand)
// ============================================================================

model PathInstance {
  id          String             @id @default(uuid())
  pathId      String             @map("path_id")
  path        Path               @relation(fields: [pathId], references: [id])
  patientId   String             @map("patient_id")
  patient     Patient            @relation(fields: [patientId], references: [id])
  demandId    String             @map("demand_id")
  status      PathInstanceStatus @default(IN_PROGRESS)
  currentStep Int                @default(1) @map("current_step")
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")
  orgId       String             @map("org_id")
  steps       PathInstanceStep[]

  @@index([patientId])
  @@index([demandId])
  @@index([orgId, status])
  @@map("path_instances")
}

model PathInstanceStep {
  id          String                 @id @default(uuid())
  instanceId  String                 @map("instance_id")
  instance    PathInstance           @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId      String                 @map("step_id")
  step        PathStep               @relation(fields: [stepId], references: [id])
  stepOrder   Int                    @map("step_order")
  status      PathStepInstanceStatus @default(PENDING)
  dueDate     DateTime               @map("due_date")
  completedAt DateTime?              @map("completed_at")
  notes       String?

  // Reverse relation for FollowupRecord link (FOLLOW-02)
  followupRecords FollowupRecord[]

  @@index([instanceId, stepOrder])
  @@map("path_instance_steps")
}

enum PathInstanceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PathStepInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  OVERDUE
}

// ============================================================================
// Notification
// ============================================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  link      String?
  read      Boolean          @default(false)
  orgId     String           @map("org_id")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([orgId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  PATH_OVERDUE
  FOLLOWUP_DUE
  FOLLOWUP_OVERDUE
  SYSTEM
}

// ============================================================================
// Touchpoint (Patient Interaction Record)
// ============================================================================

model Touchpoint {
  id                String            @id @default(uuid())
  patientId         String            @map("patient_id")
  orgId             String            @map("org_id")
  demandId          String?           @map("demand_id")
  type              TouchpointType
  channel           TouchpointChannel
  title             String
  content           String?
  sentiment         Sentiment?
  feedback          Feedback? // PRD: 满意/一般/不满
  satisfactionScore Int?              @map("satisfaction_score") // PRD: 满意度分值 1-10
  duration          Int? // Duration in seconds
  outcome           String?
  nextPlan          String?           @map("next_plan") // PRD: 下次跟进计划
  nextPlanTime      DateTime?         @map("next_plan_time") // PRD: 计划跟进时间
  followupRequired  Boolean           @default(false) @map("followup_required")
  followupDate      DateTime?         @map("followup_date")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Soft-delete fields (TOUCH-05: touchpoints are never hard-deleted, only voided)
  voidedAt     DateTime? @map("voided_at")
  voidedReason String?   @map("voided_reason")

  // Relations
  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([patientId])
  @@index([demandId])
  @@index([type])
  @@index([createdAt])
  @@index([voidedAt])
  @@map("touchpoints")
}

enum TouchpointType {
  VISIT
  CALL
  MESSAGE
  EMAIL
  WECHAT
  VIDEO
  SMS
  OTHER
}

enum TouchpointChannel {
  OFFLINE
  ONLINE
  MOBILE
  PHONE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Feedback {
  SATISFIED // 满意
  NEUTRAL // 一般
  DISSATISFIED // 不满
}

// ============================================================================
// Follow-up Management
// ============================================================================

model FollowupPlan {
  id            String         @id @default(uuid())
  patientId     String         @map("patient_id")
  orgId         String         @map("org_id")
  name          String
  type          FollowupType
  status        FollowupStatus @default(ACTIVE)
  frequencyDays Int?           @map("frequency_days")
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime?      @map("end_date") @db.Date
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // FOLLOW-01: assigned user for followup responsibility
  assignedUserId String? @map("assigned_user_id")
  assignedUser   User?   @relation("FollowupAssignedUser", fields: [assignedUserId], references: [id])

  // LINK-01: link to path template for path-based follow-up
  pathId String? @map("path_id")
  path   Path?   @relation(fields: [pathId], references: [id])

  // Relations
  patient      Patient          @relation(fields: [patientId], references: [id])
  organization Organization     @relation(fields: [orgId], references: [id])
  records      FollowupRecord[]

  @@index([orgId])
  @@index([patientId])
  @@index([assignedUserId])
  @@map("followup_plans")
}

enum FollowupType {
  ROUTINE
  POST_TREATMENT
  PRE_APPOINTMENT
  CUSTOM
}

enum FollowupStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model FollowupRecord {
  id            String               @id @default(uuid())
  planId        String               @map("plan_id")
  patientId     String               @map("patient_id")
  orgId         String               @map("org_id")
  scheduledAt   DateTime             @map("scheduled_at")
  completedAt   DateTime?            @map("completed_at")
  status        FollowupRecordStatus @default(PENDING)
  outcome       String?
  notes         String?
  completedById String?              @map("completed_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  // FOLLOW-02: link to path instance step
  pathInstanceStepId String?           @map("path_instance_step_id")
  pathInstanceStep   PathInstanceStep? @relation(fields: [pathInstanceStepId], references: [id])

  // Relations
  plan         FollowupPlan @relation(fields: [planId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([planId])
  @@index([patientId])
  @@index([pathInstanceStepId])
  @@map("followup_records")
}

enum FollowupRecordStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

// ============================================================================
// Patient Journey Milestones
// ============================================================================

model JourneyMilestone {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  orgId       String   @map("org_id")
  milestone   String
  category    String
  description String?
  occurredAt  DateTime @map("occurred_at")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, patientId])
  @@map("journey_milestones")
}

// ============================================================================
// Health Record Management (HEALTH-01, HEALTH-02)
// ============================================================================

model HealthRecord {
  id          String               @id @default(uuid())
  patientId   String               @map("patient_id")
  orgId       String               @map("org_id")
  category    HealthRecordCategory
  title       String
  description String?              @db.Text
  recordDate  DateTime             @map("record_date") @db.Date
  data        Json? // Flexible: { value, unit, referenceRange, fileUrl }
  source      String               @default("manual") // "manual", "his", "lab_system"
  createdAt   DateTime             @default(now()) @map("created_at")

  // Relations
  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([patientId, recordDate])
  @@index([orgId])
  @@map("health_records")
}

enum HealthRecordCategory {
  ALLERGY
  PAST_HISTORY
  EXAM_RESULT
  DIAGNOSIS
  TREATMENT
}

// ============================================================================
// Health Reminder (HEALTH-03)
// ============================================================================

model HealthReminder {
  id        String         @id @default(uuid())
  patientId String         @map("patient_id")
  orgId     String         @map("org_id")
  type      ReminderType
  title     String
  content   String?        @db.Text
  remindAt  DateTime       @map("remind_at") @db.Timestamp
  status    ReminderStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([patientId, remindAt])
  @@index([orgId, status])
  @@map("health_reminders")
}

enum ReminderType {
  REVIEW
  MEDICATION
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}
