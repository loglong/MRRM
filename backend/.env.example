# MRRM Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgresql://mrrm:mrrm_password@localhost:5432/mrrm?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Authing SSO (Authentication)
AUTHING_APP_ID=your_authing_app_id
AUTHING_APP_SECRET=your_authing_app_secret
AUTHING_CALLBACK_URL=http://localhost:3000/api/v1/auth/sso/callback
AUTHING_LOGOUT_CALLBACK_URL=http://localhost:3000
AUTHING_ENDPOINT=https://oauth.authing.cn

# CORS
CORS_ORIGIN=http://localhost:5173

# MiniMax LLM (for AI-01 followup recommendations)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
MINIMAX_MODEL=abab6.5s
LLM_CACHE_TTL_SECONDS=3600
